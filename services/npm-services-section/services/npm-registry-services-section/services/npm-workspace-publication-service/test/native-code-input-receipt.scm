;;; Explicit native preflight test: input JSON, no programme build.
(use-modules (native-code-programme) (guix store) (guix gexp) (guix monads)
             (gcrypt hash) (rnrs bytevectors) (json))
(define args (cdr (command-line)))
(when (not (= (length args) 1)) (display "UNRECEIVED: native input JSON required\n" (current-error-port)) (exit 78))
(define input (json-string->scm (car args)))
(define (get key) (or (assoc-ref input key) (error "UNRECEIVED native input" key)))
(define (refuses thunk) (catch #t (lambda () (thunk) #f) (lambda args #t)))
(unless (and
 (refuses (lambda () (receive-native-code-output '((kind . "serialized-claim")) "/gnu/store/pretend")))
 (refuses (lambda () (native-code-construction "/unreceived" "entry.mjs" #:native-receipt "/caller-receipt")))
 (refuses (lambda () (native-code-source-construction "/unreceived" "entry.mjs" #:observer-command "/caller-script"))))
 (error "public Data supplied native proof/observer"))
(define construction
 (native-code-construction (get "source") (get "entry")
  #:node-program (get "node") #:parser-module (get "parser") #:policy-module (get "policy")
  #:bill-file (get "bill") #:incumbent-package (get "incumbent")))
(with-store store
 (let* ((object ((@@ (native-code-programme) construction-receipt) construction))
        (expected (store-path "text" (sha256 (string->utf8 (plain-file-content object))) (plain-file-name object)))
        (preexisting (valid-path? store expected))
        (link (get "retentionRoot")))
  (display (scm->json-string `((kind . "native-input-receipt-test-plan")
    (receipt . ,expected) (preexisting . ,preexisting) (root . ,link)))) (newline) (force-output)
  (let ((actual (run-with-store store (lower-object object))))
   (unless (equal? expected actual) (error "native text identity differs"))
   (when (file-exists? link) (error "test root already exists; original custody must be received"))
   (symlink actual link) (add-indirect-root store link)
   (display (scm->json-string `((kind . "native-prepared-v1-construction.received/v1")
    (construction . ,(native-code-construction? construction))
    (receipt . ,actual) (preexisting . ,preexisting) (root . ,link)
    (registered . ,(valid-path? store actual)) (programmeBuilt . #f)))) (newline))))
