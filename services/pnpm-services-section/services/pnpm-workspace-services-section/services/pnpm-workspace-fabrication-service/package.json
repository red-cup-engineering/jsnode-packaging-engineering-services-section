{
  "name": "@red-cup-engineering/pnpm-workspace-fabrication-service",
  "version": "0.0.0",
  "description": "Fabricates an explicitly ordered pnpm workspace as a customer artifact without granting workspace authority over the provider organism.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/jsnode-packaging-engineering-services-section.git",
    "directory": "services/pnpm-services-section/services/pnpm-workspace-services-section/services/pnpm-workspace-fabrication-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./src/fabricate-pnpm-workspace.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json",
    "examples/quickstart.test.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "fabricate-pnpm-workspace": "./scripts/fabricate-pnpm-workspace.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "verify:pnpm": "node acceptance/pnpm12-receiving.mjs",
    "verify": "node --check src/fabricate-pnpm-workspace.mjs && node --check scripts/fabricate-pnpm-workspace.mjs && npm test && npm run pack:dry-run",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
